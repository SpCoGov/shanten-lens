{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shanten Lens",
  "identifier": "app.shanten.lens",
  "build": {
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "pnpm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "splash",
        "title": "向听镜 - 正在启动…",
        "width": 420,
        "height": 300,
        "resizable": false,
        "decorations": false,
        "center": true,
        "alwaysOnTop": true,
        "url": "splash.html"
      },
      {
        "label": "main",
        "title": "向听镜 - Shanten Lens",
        "width": 1500,
        "height": 920,
        "minWidth": 600,
        "minHeight": 500,
        "resizable": true,
        "visible": false,
        "devtools": true,
        "decorations": false
      }
    ],
    "security": {
      "devCsp": "default-src 'self' tauri: asset: blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://api.github.com http://ipc.localhost tauri: ipc:;",
      "csp": "default-src 'self' tauri: asset: blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' https://api.github.com http://ipc.localhost tauri: ipc:;",
      "capabilities": [
        {
          "identifier": "window-controls",
          "windows": [
            "main",
            "overlay",
            "settings",
            "splash",
            "msgbox",
            "msgbox-*",
            "packet-viewer"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:event:allow-emit",
            "core:event:allow-emit-to",
            "core:webview:allow-get-all-webviews",
            "core:webview:allow-create-webview-window",
            "core:window:allow-get-all-windows",
            "core:window:allow-start-dragging",
            "core:window:allow-minimize",
            "core:window:allow-toggle-maximize",
            "core:window:allow-internal-toggle-maximize",
            "core:window:allow-set-focus",
            "core:window:allow-show",
            "core:window:allow-center",
            "core:window:allow-close",
            "core:window:allow-current-monitor",
            "core:window:allow-inner-size",
            "core:window:allow-set-size",
            "opener:allow-open-url",
            "os:allow-locale",
            "os:allow-platform"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
